---
const { title, description = 'A simulated IPL-style auction arena with 10 franchise agents and a pre-registered forecast.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  ['', 'Home'], ['franchises/', 'Franchises'], ['forecast/', 'Forecast'],
  ['scorecard/', 'Scorecard'], ['hash/', 'Hash & pre-registration'],
];
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <meta name="description" content={description} />
  <title>{title} · IPL Auction Arena (unofficial)</title>
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header>
    <div class="wrap bar">
      <a class="brand" href={base}>Auction Arena</a>
      <nav aria-label="Main">
        <ul>
          {nav.map(([p, label]) => {
            const href = base + p;
            return <li><a href={href} aria-current={here === href ? 'page' : undefined}>{label}</a></li>;
          })}
        </ul>
      </nav>
    </div>
  </header>
  <main id="main" class="wrap"><slot /></main>
  <footer>
    <div class="wrap">
      <p><strong>Not official. Not affiliated.</strong> This is an independent research and learning project. It is not endorsed by, or connected to, the IPL, the BCCI, or any franchise. No logos or official branding are used; team colours are only an accent. No betting, odds or fantasy angle. Models describe franchise seats, not individual people.</p>
      <p>Forecasts are experimental, may be wrong, and are published to be scored in public, including when they lose.</p>
    </div>
  </footer>
</body>
</html>
<style is:global>
  :root {
    --bg: #fafaf7; --fg: #1b1d21; --muted: #5d6470; --card: #ffffff; --line: #dcdcd4;
    --accent: #0b6b57; --warn-bg: #fff3cd; --warn-fg: #5c4400; --warn-line: #e0b800;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121417; --fg: #e8e9ec; --muted: #a2a8b3; --card: #1b1e23; --line: #31353d;
      --accent: #4fd1b0; --warn-bg: #3a2f08; --warn-fg: #ffe9a3; --warn-line: #a88700;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.6 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
  .wrap { max-width: 62rem; margin: 0 auto; padding: 0 1rem; }
  .skip { position: absolute; left: -999px; top: 0; background: var(--accent); color: var(--bg); padding: .5rem 1rem; z-index: 10; }
  .skip:focus { left: 0; }
  header { border-bottom: 1px solid var(--line); background: var(--card); }
  .bar { display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; align-items: center; padding-top: .6rem; padding-bottom: .6rem; }
  .brand { font-weight: 700; color: var(--fg); text-decoration: none; font-size: 1.1rem; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .1rem .9rem; }
  nav a { color: var(--fg); text-decoration: none; padding: .25rem 0; border-bottom: 2px solid transparent; }
  nav a:hover { border-bottom-color: var(--muted); }
  nav a[aria-current] { border-bottom-color: var(--accent); font-weight: 600; }
  a { color: var(--accent); }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  main { padding-top: 1.5rem; padding-bottom: 3rem; }
  h1 { line-height: 1.2; margin: .2rem 0 .8rem; }
  h2 { margin-top: 2rem; }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: 44rem; }
  .banner { background: var(--warn-bg); color: var(--warn-fg); border: 1px solid var(--warn-line); border-radius: 8px; padding: .7rem 1rem; margin: 1rem 0; }
  .grid { display: grid; gap: .9rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); padding: 0; list-style: none; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: .9rem 1rem; border-top: 5px solid var(--c, var(--line)); }
  .card h3 { margin: 0 0 .2rem; font-size: 1.05rem; }
  .muted { color: var(--muted); }
  .tablewrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; background: var(--card); margin: 1rem 0; }
  table { border-collapse: collapse; width: 100%; font-size: .93rem; }
  th, td { padding: .45rem .7rem; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-weight: 600; background: color-mix(in srgb, var(--line) 35%, transparent); }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  caption { text-align: left; padding: .5rem .7rem; font-weight: 600; }
  .pending { color: var(--muted); font-style: italic; }
  .bar-cell { display: flex; align-items: center; gap: .5rem; min-width: 7rem; }
  .meter { flex: 1; height: .6rem; background: var(--line); border-radius: 4px; overflow: hidden; }
  .meter > span { display: block; height: 100%; background: var(--accent); }
  code, pre { font-family: ui-monospace, Consolas, monospace; font-size: .9em; }
  pre { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: .8rem 1rem; overflow-x: auto; }
  .hash { word-break: break-all; font-size: 1rem; }
  footer { border-top: 1px solid var(--line); padding: 1rem 0 2rem; color: var(--muted); font-size: .88rem; }
  @media (max-width: 40rem) { body { font-size: 15.5px; } }
</style>
