---
import Base from '../layouts/Base.astro';
import { forecast, franchises, fmtLakh, pct } from '../lib/data.js';
const fc = forecast();
const ids = franchises().filter(f => f.status === 'active').map(f => f.id);
const fake = fc.status !== 'FROZEN';
---
<Base title="Forecast">
  <h1>Forecast: 16 December 2026 auction</h1>
  {fake ? (
    <div class="banner" role="alert"><strong>FAKE SAMPLE DATA.</strong> The numbers below were invented to test this page. The real forecast is frozen on 15 December 2026 and its hash is on the <a href={`${import.meta.env.BASE_URL}hash/`}>hash page</a>.</div>
  ) : (
    <p class="muted">Frozen {fc.frozen_at}. Model: {fc.model}. Seeds: {fc.n_seeds}.</p>
  )}
  <p class="lede">For each player: probability of being sold, who is likely to buy (given sold), and an 80% price interval (p10 to p90, given sold).</p>

  <div class="tablewrap">
    <table>
      <caption>{fc.players.length} players · prices in INR · buyer distribution over the 10 active franchises</caption>
      <thead>
        <tr><th>Player</th><th>Role</th><th class="num">Base</th><th>P(sold)</th><th>Top buyers (given sold)</th><th class="num">Price p10 / p50 / p90</th></tr>
      </thead>
      <tbody>
        {fc.players.map(p => {
          const top = ids.map(i => [i, p.buyer_distribution[i] ?? 0]).filter(x => x[1] > 0).sort((a, b) => b[1] - a[1]).slice(0, 3);
          return (
            <tr>
              <th scope="row">{p.name}</th>
              <td>{p.role}</td>
              <td class="num">{fmtLakh(p.base_price_lakh)}</td>
              <td><div class="bar-cell"><span class="meter" aria-hidden="true"><span style={`width:${p.p_sold * 100}%`}></span></span><span>{pct(p.p_sold)}</span></div></td>
              <td>{top.map(([i, w]) => `${i} ${pct(w)}`).join(' · ')}</td>
              <td class="num">{fmtLakh(p.price_interval_lakh.p10)} / {fmtLakh(p.price_interval_lakh.p50)} / {fmtLakh(p.price_interval_lakh.p90)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <p class="muted">Schema: <code>site/data/forecast.schema.json</code>. Prices: 100 lakh = 1 crore.</p>
</Base>
