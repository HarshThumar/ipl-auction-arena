---
import Base from '../../layouts/Base.astro';
import { franchises } from '../../lib/data.js';
const base = import.meta.env.BASE_URL;
const all = franchises();
const active = all.filter(f => f.status === 'active');
const defunct = all.filter(f => f.status !== 'active');
---
<Base title="Franchises">
  <h1>Franchises</h1>
  <p class="lede">Each of the ten current franchises gets one agent. Defunct franchises have no agent; they are listed because their bidding records are part of the training data.</p>

  <h2>Current (ten agents)</h2>
  <ul class="ledger">
    {active.map(f => (
      <li style={`--c:${f.colour}`}>
        <a href={`${base}franchises/${f.id.toLowerCase()}/`}>
          <span class="swatch" aria-hidden="true"></span>
          <span class="name">{f.name}</span>
          <span class="meta">{f.id} · since {f.firstSeason}</span>
        </a>
      </li>
    ))}
  </ul>

  <h2>Defunct (history only)</h2>
  <ul class="ledger defunct">
    {defunct.map(f => (
      <li>
        <a href={`${base}franchises/${f.id.toLowerCase()}/`}>
          <span class="swatch" aria-hidden="true"></span>
          <span class="name">{f.name}</span>
          <span class="meta">{f.firstSeason}–{f.lastSeason}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
