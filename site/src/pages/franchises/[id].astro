---
import Base from '../../layouts/Base.astro';
import { franchises, forecast, pct, fmtLakh } from '../../lib/data.js';
export function getStaticPaths() {
  return franchises().map(f => ({ params: { id: f.id.toLowerCase() }, props: { f } }));
}
const { f } = Astro.props;
const base = import.meta.env.BASE_URL;
const fc = forecast();
const isActive = f.status === 'active';
const likely = isActive
  ? fc.players
      .map(p => ({ p, w: p.buyer_distribution[f.id] ?? 0 }))
      .filter(x => x.w > 0).sort((a, b) => b.w - a.w).slice(0, 5)
  : [];
---
<Base title={f.name}>
  <p class="back"><a href={`${base}franchises/`}>All franchises</a></p>
  <h1>{f.name}</h1>
  <p class="lede"><span class="swatch" style={`--c:${f.colour}`} aria-hidden="true"></span> {f.id} · {isActive ? `in the auction since ${f.firstSeason}` : `defunct, played ${f.firstSeason}–${f.lastSeason}`}</p>

  <h2>Lineage</h2>
  <ul>
    <li>Franchise id <code>{f.id}</code></li>
    {f.aliases.length > 0 && <li>Earlier names: {f.aliases.join(', ')}</li>}
    {f.notes && <li>{f.notes}</li>}
  </ul>

  {isActive ? (
    <>
      <h2>Agent</h2>
      <p class="pending">No profile yet. It appears once the team-identity model is trained.</p>
      <p class="small">The agent stands for this franchise's seat at the auction table and its past decisions. It does not model, quote or imitate any person.</p>

      <h2>Likeliest targets</h2>
      {fc.status !== 'FROZEN' && (
        <div class="notice sample">
          <span class="label">Sample data</span>
          <p>These rows are invented to test the page. They say nothing about {f.name}.</p>
        </div>
      )}
      {likely.length === 0 ? <p class="pending">No players in the current file.</p> : (
        <div class="tablewrap"><table>
          <caption>Players {f.id} is most likely to buy, if they are sold</caption>
          <thead><tr><th scope="col">Player</th><th scope="col">Role</th><th scope="col" class="num">Chance {f.id} buys</th><th scope="col" class="num">Median price</th></tr></thead>
          <tbody>
            {likely.map(({ p, w }) => (
              <tr><th scope="row">{p.name}</th><td>{p.role}</td><td class="num">{pct(w)}</td><td class="num">{fmtLakh(p.price_interval_lakh.p50)}</td></tr>
            ))}
          </tbody>
        </table></div>
      )}
    </>
  ) : (
    <p class="muted">This franchise no longer exists, so it has no agent. Its past auction records are part of the historical data.</p>
  )}
</Base>
