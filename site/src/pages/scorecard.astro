---
import Base from '../layouts/Base.astro';
import { l2 } from '../lib/data.js';
const { scores, aiq, llm } = l2();
const seasons = ['2023', '2024'];
const metrics = [
  ['sold_auc', 'Sold AUC', 'higher is better'],
  ['sold_brier', 'Sold Brier', 'lower is better'],
  ['buyer_top3', 'Buyer top-3 hit rate', 'higher is better'],
  ['spearman', 'Price rank correlation', 'higher is better'],
  ['log_price_mae', 'Log-price MAE', 'lower is better'],
  ['interval80_coverage', '80% interval coverage', 'target 0.80'],
];
const f = v => (v === null || v === undefined ? '—' : v.toFixed(3));
const cell = (obj, k) => (obj ? f(obj[k]) : '—');
const llmModel = llm ? Object.keys(llm)[0] : null;
---
<Base title="Scorecard">
  <h1>Scorecard</h1>
  <p class="lede">Five-way comparison after the 16 December 2026 auction: our model, base price, LightGBM, AuctionIQ and a pundit mock. Until then the "our model" and pundit columns stay empty. The other columns show <strong>backtests on past seasons</strong>, so you can see how hard the baselines are to beat.</p>
  <div class="banner" role="note"><strong>Read this first.</strong> Backtest numbers below are on 2023 and 2024 lots, not on the live auction, and some baselines win some rows. Nothing here is a claim that our model works: it has not been scored yet. Dec 2025 backtests are contaminated, so they are not used as evidence.</div>

  {!scores && <p class="pending">Baseline file <code>data/processed/l2/l2_scores.json</code> not found at build time.</p>}

  {scores && seasons.map(s => {
    const base = scores.lots?.[s]?.base_price;
    const ai = aiq?.seasons?.[s]?.value_model?.called;
    return (
      <>
        <h2>Lot level, {s} auction</h2>
        <div class="tablewrap"><table>
          <caption>{base?.n_lots} lots called, {base?.n_sold} sold</caption>
          <thead><tr><th>Metric</th><th class="num">Our model</th><th class="num">Base price</th><th class="num">LightGBM</th><th class="num">AuctionIQ</th><th class="num">Pundit mock</th></tr></thead>
          <tbody>
            {metrics.map(([k, label, hint]) => (
              <tr>
                <th scope="row">{label}<br /><span class="muted">{hint}</span></th>
                <td class="num pending">pending</td>
                <td class="num">{cell(base, k)}</td>
                <td class="num muted" title="LightGBM is scored on keep/drop decisions, see below">n/a</td>
                <td class="num">{cell(ai, k)}</td>
                <td class="num pending">pending</td>
              </tr>
            ))}
          </tbody>
        </table></div>
      </>
    );
  })}
  <p class="muted">"—" means the baseline does not produce that quantity. AuctionIQ is scored on the lots we matched to its player list (<code>auctioniq_scores.json</code>); its commit is pinned there. LightGBM here predicts keep/drop decisions, not lot outcomes, so it has no lot-level numbers.</p>

  {scores && (
    <>
      <h2>Decision level (keep or drop), log loss</h2>
      <p class="muted">Lower is better. Brackets are 95% bootstrap intervals; with 95 to 169 rows they are wide.</p>
      <div class="tablewrap"><table>
        <thead><tr><th>Model</th>{seasons.map(s => <th class="num">{s} log loss</th>)}{seasons.map(s => <th class="num">{s} AUC</th>)}</tr></thead>
        <tbody>
          <tr><th scope="row">Our model</th><td class="num pending" colspan="4">pending (L3 not trained yet)</td></tr>
          {['prior', 'team_prior', 'lightgbm', 'lightgbm_no_identity'].map(m => (
            <tr>
              <th scope="row">{m.replace(/_/g, ' ')}</th>
              {seasons.map(s => {
                const x = scores.decisions?.[s]?.models?.[m];
                return <td class="num">{x ? `${f(x.log_loss)} [${f(x.log_loss_ci[0])}, ${f(x.log_loss_ci[1])}]` : '—'}</td>;
              })}
              {seasons.map(s => <td class="num">{f(scores.decisions?.[s]?.models?.[m]?.auc)}</td>)}
            </tr>
          ))}
        </tbody>
      </table></div>
      <p class="muted">A "team prior" (franchise habit only) does not beat the plain prior here, so franchise history on its own has shown no detectable signal in these backtests.</p>
    </>
  )}

  {llm && llmModel && (
    <>
      <h2>Reference: single-prompt LLM</h2>
      <p class="muted">One prompt per lot to <code>{llmModel}</code>, shown with real names and with names removed. Possibly contaminated on 2023 and 2024 (the model may have seen those auctions), so this is context, not a fair baseline.</p>
      <div class="tablewrap"><table>
        <thead><tr><th>Season</th><th>Variant</th><th class="num">Sold AUC</th><th class="num">Sold Brier</th><th class="num">Spearman</th><th class="num">Log-price MAE</th><th class="num">80% coverage</th></tr></thead>
        <tbody>
          {seasons.flatMap(s => ['named', 'anon'].map(v => {
            const x = llm[llmModel]?.[s]?.[v];
            return x ? (
              <tr><td>{s}</td><td>{v}</td><td class="num">{f(x.sold_auc)}</td><td class="num">{f(x.sold_brier)}</td><td class="num">{f(x.spearman)}</td><td class="num">{f(x.log_price_mae)}</td><td class="num">{f(x.interval80_coverage)}</td></tr>
            ) : null;
          }))}
        </tbody>
      </table></div>
    </>
  )}

  <h2>Pundit mock</h2>
  <p class="pending">Pending. A published mock list will be matched to the actual results after the auction. Only lists published before the auction count.</p>
</Base>
